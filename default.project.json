{
  "name": "MonsterVault",
  "servePort": 34872,
  "serveAddress": "127.0.0.1",
  "emitLegacyScripts": true,
  "globIgnorePaths": ["**/*.spec.luau", "**/*.test.luau"],
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "MonsterVault": {
        "$className": "Folder",
        "$ignoreUnknownInstances": false,
        "Shared": { "$path": "src/shared", "$ignoreUnknownInstances": true },
        "Remotes": {
          "$className": "Folder",
          "V1": {
            "$className": "Folder",
            "Command": { "$className": "RemoteEvent" },
            "Event": { "$className": "RemoteEvent" },
            "UnreliableEvent": { "$className": "UnreliableRemoteEvent" }
          }
        }
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "MonsterVaultServer": { "$path": "src/server", "$ignoreUnknownInstances": true }
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "MonsterVault": { "$className": "Folder", "$ignoreUnknownInstances": false }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "MonsterVaultClient": { "$path": "src/client", "$ignoreUnknownInstances": true }
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$ignoreUnknownInstances": false,
      "$properties": {
        "StreamingEnabled": true,
        "StreamingMinRadius": 64,
        "StreamingTargetRadius": 1024,
        "StreamingIntegrityMode": "PauseOutsideLoadedArea",
        "StreamOutBehavior": "Opportunistic"
      },
      "MonsterVaultWorld": {
        "$className": "Folder",
        "FixtureGround": {
          "$className": "Part",
          "$properties": {
            "Anchored": true,
            "Size": [128, 1, 128],
            "Position": [0, -0.5, 0],
            "Color": [0.17, 0.32, 0.21],
            "Material": "Grass"
          }
        },
        "FixtureSpawn": {
          "$className": "SpawnLocation",
          "$properties": {
            "Anchored": true,
            "Neutral": true,
            "Size": [8, 1, 8],
            "Position": [0, 0.5, 18]
          }
        },
        "FixtureCreatureAnchor": {
          "$className": "Part",
          "$properties": {
            "Anchored": true,
            "CanCollide": false,
            "CanTouch": false,
            "CanQuery": false,
            "Transparency": 1,
            "Size": [2, 2, 2],
            "Position": [0, 3, -16],
            "Attributes": {
              "SpawnContextId": { "String": "spawn-context/fixture-clearing" },
              "SpeciesId": { "String": "species/fixture-orb" }
            }
          }
        }
      }
    }
  }
}
